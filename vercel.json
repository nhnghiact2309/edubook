{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.js"
    }
  ],
  "includeFiles": [
    "views/**"
  ],
  {
  "functions": {
    "api/**/*.js": {
      "includeFiles": "views/**"
    },
    "app.js": {
      "includeFiles": "views/**"
    }
  }
}
}

